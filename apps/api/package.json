  "dependencies": {
    "@extra/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.0",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
