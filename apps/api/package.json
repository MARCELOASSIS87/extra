{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -F @extra/shared build && tsx watch src/index.ts",
    "build": "pnpm -F @extra/shared build && tsc",
    "start": "node dist/index.js",
