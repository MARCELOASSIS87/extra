{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -F @extra/shared build && tsx watch src/index.ts",
    "build": "pnpm -F @extra/shared build && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.seed.json",
    "test": "tsx src/auth.test.ts && tsx src/constraints.test.ts && tsx src/jobs.test.ts && tsx src/jobs-write.test.ts && tsx src/applications.test.ts && tsx src/attendance.test.ts && tsx src/workers.test.ts && tsx src/companies.test.ts && tsx src/panel.test.ts",
    "seed": "tsx prisma/seed.ts",
    "token": "tsx scripts/token.ts"
  },
  "dependencies": {
    "@extra/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.0",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@extra/fixtures": "workspace:*",
    "@types/node": "^22.19.21",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
