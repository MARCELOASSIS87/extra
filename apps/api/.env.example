# Copie para .env e preencha. O .env nunca é versionado.
# Desenvolvimento: Postgres de infra/docker-compose.dev.yml, porta 5433 no host.
DATABASE_URL="postgresql://extra:SENHA@localhost:5433/extra?schema=public"

PORT=3333

# Assinatura dos JWT. Mínimo 32 caracteres — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-chave-de-32-caracteres-ou-mais"

# Origem ÚNICA do front. Nunca "*", nunca lista: CORS que aceita qualquer
# origem é o mesmo que não ter CORS.
CORS_ORIGIN="http://localhost:3000"

NODE_ENV=development

# --- WhatsApp Cloud API (§11) ------------------------------------------------
# Número DEDICADO do negócio, dígitos E.164 sem "+". Jamais o número pessoal:
# ao virar número da Cloud API ele para de funcionar no WhatsApp comum.
WHATSAPP_BUSINESS_NUMBER="5535999999999"

# Segredo do app no Meta Business. É com ele que se confere a assinatura
# X-Hub-Signature-256 do webhook — webhook forjado aqui é login como qualquer
# pessoa. Faltando, o webhook recusa TUDO com 401.
WHATSAPP_APP_SECRET=""

# Token que você escolhe e repete no painel da Meta, no handshake GET.
WHATSAPP_VERIFY_TOKEN=""

# Credenciais de envio da resposta "Confirmado!".
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Obrigatórias quando NODE_ENV=production: sem elas ninguém entra.
