{
  "name": "@extra/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./schemas/*": {
      "types": "./dist/schemas/*.d.ts",
      "default": "./dist/schemas/*.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "default": "./dist/constants/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/schemas/schemas.test.ts && tsx src/lib/attendance.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ]
}
